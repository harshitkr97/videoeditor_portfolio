# Server
PORT=5050

# CORS (comma-separated). Example: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# MongoDB (Atlas)
# If MONGODB_URI is not set, the backend falls back to local file storage in /uploads/manifest.json
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_DB=mausam
MONGODB_MEDIA_COLLECTION=media

# Contact email (Gmail App Password, not your normal Google password)
CONTACT_RECIPIENT=mishraharshit410@gmail.com
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
